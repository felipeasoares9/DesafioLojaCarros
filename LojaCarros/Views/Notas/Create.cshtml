@model LojaCarros.Models.Nota

@{
    ViewData["Title"] = "Nova Nota de Venda";
}

<h1>Criar Nota</h1>

<h4>Detalhes da Venda</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Numero" class="control-label"></label>
                <input asp-for="Numero" class="form-control" readonly="readonly" />
                <span asp-validation-for="Numero" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ClienteId" class="control-label">Comprador</label>
                <select asp-for="ClienteId" class="form-control" asp-items="ViewBag.ClienteId"></select>
                <span asp-validation-for="ClienteId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="VendedorId" class="control-label">Vendedor</label>
                <select asp-for="VendedorId" class="form-control" asp-items="ViewBag.VendedorId"></select>
                <span asp-validation-for="VendedorId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CarroId" class="control-label">Carro Vendido</label>
                <select id="CarroId" asp-for="CarroId" class="form-control" asp-items="ViewBag.CarroId"></select>
                <span asp-validation-for="CarroId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DataEmissao" class="control-label"></label>
                <input asp-for="DataEmissao" type="date" class="form-control" />
                <span asp-validation-for="DataEmissao" class="text-danger"></span>
            </div>

            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Garantia" /> @Html.DisplayNameFor(model => model.Garantia)
                </label>
            </div>

            <div class="form-group">
                <label asp-for="ValorVenda" class="control-label"></label>
                <input id="ValorVenda" asp-for="ValorVenda" type="text" class="form-control" />
                <span asp-validation-for="ValorVenda" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Salvar Venda" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Voltar para a Lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // CORREÇÃO: Sobrescreve os métodos do jQuery Validation
        // para reconhecer a vírgula (,) como separador decimal,
        // sincronizando com a cultura pt-BR.

        $.validator.methods.range = function (value, element, param) {
            // Permite range validation com vírgula decimal
            var globalizedValue = value.replace(",", ".");
            return this.optional(element) || (globalizedValue >= param[0] && globalizedValue <= param[1]);
        };

        $.validator.methods.number = function (value, element) {
            // Permite a formatação de número pt-BR (ponto de milhar, vírgula decimal)
            return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:\.\d{3})+)(?:,\d+)?$/.test(value);
        };


        $(document).ready(function () {

            // Variável JS recebe os preços dos carros (passados via JSON).
            var carroPrecos = @Html.Raw(ViewData["CarroPrecosJson"]);

            var carroDropdown = $('#CarroId');
            var valorVendaInput = $('#ValorVenda');

            function preencherValorVenda() {
                var selectedCarroId = carroDropdown.val();

                if (selectedCarroId && carroPrecos[selectedCarroId]) {

                    // Converte o valor atual do input para um formato numérico temporário (usando ponto) para checagem.
                    var currentValue = valorVendaInput.val().replace(/\./g, '').replace(',', '.');

                    // Condição: Preenche somente se o campo estiver vazio ou com o valor '0'/'0.00'
                    if (valorVendaInput.val() === '' || parseFloat(currentValue) === 0) {

                        var preco = carroPrecos[selectedCarroId];

                        // Formata o número usando a cultura 'pt-BR'
                        var valorFormatado = preco.toLocaleString('pt-BR', {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2,
                            useGrouping: true
                        });

                        valorVendaInput.val(valorFormatado);
                    }
                }
            }

            // Adiciona listener para a mudança do dropdown de Carro
            carroDropdown.on('change', preencherValorVenda);

            // Preenche na carga inicial da página
            preencherValorVenda();
        });
    </script>
}